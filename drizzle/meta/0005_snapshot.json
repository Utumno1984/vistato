          "value": "\"fic_connections\".\"fic_company_id\" IS NULL OR \"fic_connections\".\"fic_company_id\" > 0"
        },
        "fic_connections_connected_has_company": {
          "name": "fic_connections_connected_has_company",
          "value": "\"fic_connections\".\"status\" <> 'connected' OR (\"fic_connections\".\"fic_company_id\" IS NOT NULL AND \"fic_connections\".\"company_name\" IS NOT NULL AND \"fic_connections\".\"connected_at\" IS NOT NULL AND \"fic_connections\".\"available_companies\" IS NULL)"
        },
        "fic_connections_pending_has_choices": {
          "name": "fic_connections_pending_has_choices",
          "value": "\"fic_connections\".\"status\" <> 'pending_company_selection' OR (\"fic_connections\".\"fic_company_id\" IS NULL AND \"fic_connections\".\"company_name\" IS NULL AND \"fic_connections\".\"connected_at\" IS NULL AND jsonb_typeof(\"fic_connections\".\"available_companies\") = 'array')"
        },
        "fic_connections_tokens_by_status": {
          "name": "fic_connections_tokens_by_status",
          "value": "CASE WHEN \"fic_connections\".\"status\"::text = 'reauthorization_required'\n        THEN \"fic_connections\".\"access_token_enc\" IS NULL AND \"fic_connections\".\"refresh_token_enc\" IS NULL AND \"fic_connections\".\"access_token_expires_at\" IS NULL\n          AND \"fic_connections\".\"fic_company_id\" IS NOT NULL AND \"fic_connections\".\"company_name\" IS NOT NULL AND \"fic_connections\".\"available_companies\" IS NULL\n          AND \"fic_connections\".\"last_refresh_error_at\" IS NOT NULL AND \"fic_connections\".\"last_refresh_error\" IS NOT NULL\n        ELSE \"fic_connections\".\"access_token_enc\" IS NOT NULL AND \"fic_connections\".\"refresh_token_enc\" IS NOT NULL AND \"fic_connections\".\"access_token_expires_at\" IS NOT NULL\n        END"
        },
        "fic_connections_last_refresh_error_valid": {
          "name": "fic_connections_last_refresh_error_valid",
          "value": "(\"fic_connections\".\"last_refresh_error\" IS NULL) = (\"fic_connections\".\"last_refresh_error_at\" IS NULL) AND (\"fic_connections\".\"last_refresh_error\" IS NULL OR \"fic_connections\".\"last_refresh_error\" IN ('refresh_rejected', 'save_failed'))"
        }
      },
