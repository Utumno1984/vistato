# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://vistato:vistato@localhost:5433/vistato
# Password of the demo user demo@example.com (min. 12 characters). `npm run db:seed` and the
# e2e globalSetup create the demo tenant and user only when it is set. Leave it unset in production.
# DEMO_USER_PASSWORD=demo-password-change-me
# Public origin(s) of the app, comma-separated (e.g. https://app.vistato.it). Needed behind a proxy: state-changing
# requests whose Origin header is not listed get 403. If unset, only the origin of the request URL is accepted (dev, e2e).
# APP_ORIGIN=https://app.example.com
# The session cookie is Secure unless this is "false". Set it to false only on plain http://localhost (CI, e2e).
# SESSION_COOKIE_SECURE=false
# Used by `npm test` (integration tests) and migrations for the test database
TEST_DATABASE_URL=postgres://vistato:vistato@localhost:5433/vistato_test
