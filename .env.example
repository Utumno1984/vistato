# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://vistato:vistato@localhost:5433/vistato
# Password of the demo user demo@example.com (min. 12 characters). `npm run db:seed` and the
# e2e globalSetup create the demo tenant and user only when it is set. Leave it unset in production.
# DEMO_USER_PASSWORD=demo-password-change-me
# Public origin(s) of the app, comma-separated (e.g. https://app.vistato.it). Needed behind a proxy: state-changing
# requests whose Origin header is not listed get 403. If unset, only the origin of the request URL is accepted (dev, e2e).
# APP_ORIGIN=https://app.example.com
# The session cookie is Secure unless this is "false". Set it to false only on plain http://localhost (CI, e2e).
# SESSION_COOKIE_SECURE=false
# Key (32 random bytes, base64) for the at-rest encryption of per-tenant secrets such as the Fatture in
# Cloud tokens. Generate it with: openssl rand -base64 32 (no spaces or line breaks around the value).
# Not needed to start the app or run the tests: only encrypting or decrypting a secret requires it.
# SECRETS_ENCRYPTION_KEY=
# Rotation: put the new key in SECRETS_ENCRYPTION_KEY and the old one here; values of the old key still
# decrypt and are flagged for re-encryption. Remove it once every value has been re-encrypted.
# SECRETS_ENCRYPTION_KEY_PREVIOUS=
# Base URL of the Fatture in Cloud API v2 (http or https, no credentials, query or fragment; a trailing
# slash is ignored). Default https://api-v2.fattureincloud.it. Point it at a fake FiC in tests and e2e.
# FIC_API_BASE_URL=https://api-v2.fattureincloud.it
# Prudential per-company limit of FiC requests, per process (FiC reports 300 every 5 minutes; FiC's 429
# stays the source of truth). Positive integers. Defaults: 280 requests every 300 seconds.
# FIC_RATE_LIMIT_MAX_REQUESTS=280
# FIC_RATE_LIMIT_WINDOW_SECONDS=300
# Used by `npm test` (integration tests) and migrations for the test database
TEST_DATABASE_URL=postgres://vistato:vistato@localhost:5433/vistato_test
